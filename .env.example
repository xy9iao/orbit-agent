# Copy to .env and fill in. Never commit .env.
OPENAI_API_KEY=sk-...
TELEGRAM_BOT_TOKEN=123456:ABC...
TELEGRAM_OWNER_CHAT_ID=123456789      # only this chat is answered; get it from @userinfobot

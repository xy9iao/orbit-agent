# Copy to .env and fill in. Never commit .env.
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...     # Claude models (chat, extract, ...); embeddings stay on OpenAI
TELEGRAM_BOT_TOKEN=123456:ABC...
TELEGRAM_OWNER_CHAT_ID=123456789      # only this chat is answered; get it from @userinfobot
# Optional: proxy for OpenAI + Telegram (needed in mainland China)
# PROXY_URL=http://127.0.0.1:7890
# Optional: override project root (defaults to the repo directory)
# ORBIT_HOME=C:\Users\User\work\orbit
# Postgres + pgvector (docker compose up -d postgres). Inside compose, orbit gets its own URL.
DATABASE_URL=postgresql+asyncpg://orbit:orbit@127.0.0.1:5432/orbit
# Used by pytest only; tables are truncated on every test.
TEST_DATABASE_URL=postgresql+asyncpg://orbit:orbit@127.0.0.1:5432/orbit_test
